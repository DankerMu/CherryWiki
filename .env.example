# =============================================================================
# CherryGraph Studio — Phase 1 Development Environment Variables
# Copy to .env and replace dev defaults before using shared or production data.
# =============================================================================

# --- App ---
APP_URL=http://localhost
JWT_SECRET=change-me-in-production-32-characters-minimum
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# --- Stage 1 Admin Seed / Tenant ---
ADMIN_EMAIL=admin@cherrywiki.local
ADMIN_PASSWORD=ChangeMe123!
# Optional; keep the seeded tenant id for deterministic local development.
DEFAULT_TENANT_ID=default

# --- PostgreSQL ---
POSTGRES_PASSWORD=cherrygraph_dev
# Docker internal URL (used by containers):
DATABASE_URL=postgresql://cherrygraph:cherrygraph_dev@postgres:5432/cherrygraph
# Host-side URL (for pnpm db:migrate from terminal):
# DATABASE_URL=postgresql://cherrygraph:cherrygraph_dev@localhost:5432/cherrygraph

# --- Redis ---
# Host-side URL for local pnpm dev:
REDIS_URL=redis://localhost:6379
# Docker Compose internal URL for services in docker-compose.yml:
COMPOSE_REDIS_URL=redis://redis:6379

# --- MinIO / S3 ---
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev_secret
STORAGE_BUCKET_PREFIX=cherrywiki

# --- Worker Internal API ---
WORKER_API_KEY=dev-worker-api-key

# --- Model API ---
MODEL_API_BASE_URL=http://localhost:11434
MODEL_API_KEY=dev-model-key
DEFAULT_CHAT_MODEL=gpt-4.1
DEFAULT_EMBEDDING_MODEL=text-embedding-3-large

# --- Graphify ---
GRAPHIFY_WORKDIR=/work/graphify
GRAPHIFY_DEFAULT_MODE=deep
GRAPHIFY_ENABLE_WIKI=true
GRAPHIFY_TIMEOUT_SECONDS=3600
GRAPHIFY_MAX_NODES=50000
GRAPHIFY_MAX_EDGES=200000

# --- Graphify Claude Code Runner ---
AGENT_ANTHROPIC_API_KEY=your-anthropic-api-key-here
AGENT_ANTHROPIC_BASE_URL=https://your-proxy-gateway.example.com
AGENT_ANTHROPIC_MODEL=deepseek-v4-flash
GRAPHIFY_REF=58271fb5af4c0c123ddbad9c689ee1e220360be8
CLAUDE_CODE_VERSION=1.0.18
GRAPHIFY_MAX_INPUT_FILES=150
GRAPHIFY_MAX_INPUT_WORDS=1500000
GRAPHIFY_RUNNER_MODE=claude_code

# --- Worker ---
WORKER_HEALTH_PORT=9090

# --- Upload ---
UPLOAD_MAX_SIZE_MB=50
UPLOAD_HARD_LIMIT_MB=200

# --- SSRF Protection (url-fetcher-worker) ---
URL_FETCH_TIMEOUT_SECONDS=30
URL_FETCH_MAX_RESPONSE_BYTES=52428800
HTTP_PROXY=http://egress-proxy:3128
HTTPS_PROXY=http://egress-proxy:3128
NO_PROXY=cherry-api,minio,localhost,127.0.0.1

# --- Compose Profiles ---
# Enables the docmost and wiki-sync-worker services by default.
COMPOSE_PROFILES=docmost

# --- Docmost (Phase 2) ---
DOCMOST_BASE_URL=http://localhost:3000
DOCMOST_APP_SECRET=dev-docmost-app-secret-minimum-32-chars
DOCMOST_DB_PASSWORD=docmost_dev
DOCMOST_BRIDGE_SECRET=dev-docmost-bridge-secret
DOCMOST_ADMIN_EMAIL=admin@cherrywiki.local
DOCMOST_ADMIN_PASSWORD=changeme-initial-setup
DOCMOST_FORK_BUILD=true

# --- MCP Gateway (Phase 4 — not used in Phase 1) ---
MCP_ALLOWED_TOOLS=

# --- Logging ---
LOG_LEVEL=info
NODE_ENV=development
