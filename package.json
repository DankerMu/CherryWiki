{
  "name": "cherrygraph-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "dev:infra": "docker compose up -d postgres redis minio",
    "dev:up": "docker compose up -d",
    "dev:down": "docker compose down",
    "build": "pnpm -r --if-present build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:backup-restore": "bash scripts/__tests__/backup-restore.sh",
    "secret:scan": "node scripts/secret-hygiene-scan.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "argon2",
      "bcrypt",
      "core-js",
      "esbuild",
      "msgpackr-extract",
      "protobufjs"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@redocly/cli": "^2.30.2",
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^4.1.5",
    "argon2": "^0.44.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.1",
    "pg": "^8.20.0",
    "prettier": "^3.6.2",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.7"
  }
}
